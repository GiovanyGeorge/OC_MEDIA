# =============================================================================
# OC Media Platform — Environment Variables Reference
# =============================================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.
#
# Firebase Web API keys are project identifiers (not secret credentials).
# It is safe to include VITE_FIREBASE_* variables in the frontend bundle.
# Service account private keys must ONLY be stored in Cloudflare Secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase Project Configuration (Public — safe in frontend)
# -----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_PROJECT_ID=oc-media-2026
VITE_FIREBASE_AUTH_DOMAIN=oc-media-2026.firebaseapp.com
VITE_FIREBASE_STORAGE_BUCKET=oc-media-2026.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# -----------------------------------------------------------------------------
# Existing Variables (keep these)
# -----------------------------------------------------------------------------
VITE_GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_APPS_SCRIPT_DEPLOYMENT_ID/exec
VITE_ADMIN_PASSCODE=OC@2026

# =============================================================================
# Backend / Cloudflare Pages Functions (NEVER put these in .env — Cloudflare only)
# =============================================================================
# These are listed here for documentation ONLY.
# Store them in: Cloudflare Dashboard → Pages → Settings → Environment Variables → Encrypted
#
# GOOGLE_SERVICE_ACCOUNT_JSON   Full JSON content of Firebase service account key
# GOOGLE_SERVICE_ACCOUNT_EMAIL  Service account email (from JSON "client_email")
# GOOGLE_PRIVATE_KEY            Private key (from JSON "private_key")
# FIREBASE_PROJECT_ID           oc-media-2026
# ACTIVATION_HMAC_SECRET        High-entropy secret key for HMAC-SHA256 activation tokens
# ALLOWED_ORIGINS               Allowed CORS origins (e.g. https://your-app.pages.dev,http://localhost:5173)
